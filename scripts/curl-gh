#!/usr/bin/env bash
# curl wrapper for the thirdparty downloader (usage: curl -o FILE -L --silent --show-error --location URL).
# GitHub is intermittently answering 504 (a 92-byte "Gateway Time-out" page) for downloads; releases/download
# URLs (also via redirects, e.g. openssl.org) fail persistently but work through the API. So: use `gh api`
# for release assets, real curl otherwise, and retry with backoff while the answer is the 504 page.
out=""; url=""; prev=""
for a in "$@"; do [ "$prev" = -o ] && out=$a; prev=$a; url=$a; done
re='^https://github\.com/([^/]+)/([^/]+)/releases/download/([^/]+)/([^/?]+)'

fetch() {
  final=$(/usr/bin/curl -sIL -m 30 -o /dev/null -w '%{url_effective}' "$url" 2>/dev/null)
  if [[ $final =~ $re ]]; then
    local o=${BASH_REMATCH[1]} r=${BASH_REMATCH[2]} t=${BASH_REMATCH[3]} n=${BASH_REMATCH[4]} id
    id=$(gh api "repos/$o/$r/releases/tags/$t" --jq ".assets[]|select(.name==\"$n\")|.id" 2>/dev/null) || return 1
    [ -n "$id" ] || return 1
    gh api -H "Accept: application/octet-stream" "repos/$o/$r/releases/assets/$id" > "$out"
  else
    /usr/bin/curl "$@"
  fi
}

for i in 1 2 3 4 5 6 7 8; do
  fetch "$@" && ! { [ -f "$out" ] && [ "$(stat -c %s "$out")" -lt 300 ] && grep -q "504 Gateway" "$out"; } && exit 0
  echo "curl-gh: attempt $i failed or got a 504 page for $url; retrying" >&2
  sleep $((i * 15))
done
exit 1
